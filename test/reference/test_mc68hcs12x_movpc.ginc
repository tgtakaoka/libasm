;;; PC-relative move
        movb    #18, 0x80,pc
        movb    #18, 0x0FFF,pc
        movb    1,pc, 0x64,x
        movb    0,pc, 0x1234,x
        movb    0,pc, [0x1234,x]
        movb    0,pc, [d,x]
        movb    0x80,pc, 2,x
        movb    0x0FFF,pc, 2,x
        movb    1,x, 0x80,pc
        movb    1,x, 0x0FFF,pc
        movb    0x0FFF,pc, 0x1FF8,pc
        movw    #0x1234, 0x0FFF,pc
        movw    0x80,pc, 0x1234,y
        movw    0x0FFF,pc, 0x1234,y
;;; Local Variables:
;;; mode: asm
;;; End:
;;; vim: set ft=asm:
