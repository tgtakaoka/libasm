!!! SH-2 additional instructions

!! BF/S label (1000 1111 dddd dddd) branch if T=0 with delay slot -- d=(N-4)/2
        bf/s    .+4                     ;# 8F00
        bf/s    .+6                     ;# 8F01
        bf/s    .+0x84                  ;# 8F40
        bf/s    .-2                     ;# 8FFD

!! BT/S label (1000 1101 dddd dddd) branch if T=1 with delay slot -- d=(N-4)/2
        bt/s    .+4                     ;# 8D00
        bt/s    .+6                     ;# 8D01
        bt/s    .+0x84                  ;# 8D40
        bt/s    .-2                     ;# 8DFD

!! BRAF Rm (0000 mmmm 0010 0011) branch far via register, delay slot
        braf    r0                      ;# 0023
        braf    r7                      ;# 0723
        braf    r15                     ;# 0F23

!! BSRF Rm (0000 mmmm 0000 0011) branch to subroutine far via register, delay slot
        bsrf    r0                      ;# 0003
        bsrf    r7                      ;# 0703
        bsrf    r15                     ;# 0F03

!! DMULS.L Rm,Rn (0011 nnnn mmmm 1101) 32x32 signed multiply -> 64-bit MACH:MACL
        dmuls.l r0, r1                  ;# 310D
        dmuls.l r14, r15                ;# 3FED

!! DMULU.L Rm,Rn (0011 nnnn mmmm 0101) 32x32 unsigned multiply -> 64-bit MACH:MACL
        dmulu.l r0, r1                  ;# 3105
        dmulu.l r14, r15                ;# 3FE5

!! DT Rn (0100 nnnn 0001 0000) decrement and test
        dt      r0                      ;# 4010
        dt      r7                      ;# 4710
        dt      r15                     ;# 4F10

!! MAC.L @Rm+,@Rn+ (0000 nnnn mmmm 1111) 32x32 multiply-accumulate with post-increment
        mac.l   @r0+, @r1+              ;# 010F
        mac.l   @r14+, @r15+            ;# 0FEF

!! MUL.L Rm,Rn (0000 nnnn mmmm 0111) 32x32 multiply -> MACL
        mul.l   r0, r1                  ;# 0107
        mul.l   r14, r15                ;# 0FE7
