        .byte   0xB7, 0xA8 ;# exg     ccrh, a
        .byte   0xB7, 0xD8 ;# exg     xh, a
        .byte   0xB7, 0xE8 ;# exg     yh, a
        .byte   0xB7, 0xF8 ;# exg     sph, a
        .byte   0xB7, 0x8A ;# exg     a, ccrh
        .byte   0xB7, 0xAA ;# exg     ccrw, ccrw
        .byte   0xB7, 0xCA ;# exg     d, ccrw
        .byte   0xB7, 0xDA ;# exg     x, ccrw
