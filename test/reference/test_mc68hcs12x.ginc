;;; transfer/exchange
        tfr     ccr, a
        tfr     ccr, b
        tfr     ccr, ccr
        tfr     a, ccr
        tfr     b, ccr
        tfr     d, ccr
        tfr     x, a
        tfr     x, b
        tfr     x, ccr
        tfr     y, a
        tfr     y, b
        tfr     y, ccr
        tfr     sp, a
        tfr     sp, b
        tfr     sp, ccr
        .byte   0xB7, 0x28 ;# tfr     ccrh, a
        .byte   0xB7, 0x58 ;# tfr     xh, a
        .byte   0xB7, 0x68 ;# tfr     yh, a
        .byte   0xB7, 0x78 ;# tfr     sph, a
        .byte   0xB7, 0x0A ;# tfr     a, ccrh
        .byte   0xB7, 0x2A ;# tfr     ccrw, ccrw
        .byte   0xB7, 0x4A ;# tfr     d, ccrw
        .byte   0xB7, 0x5A ;# tfr     x, ccrw
        .byte   0xB7, 0x6A ;# tfr     y, ccrw
        .byte   0xB7, 0x7A ;# tfr     sp, ccrw
        .byte   0xB7, 0x2C ;# tfr     ccrw, d
        .byte   0xB7, 0x0D ;# tfr     a, xh
        .byte   0xB7, 0x1D ;# tfr     b, xl
        .byte   0xB7, 0x2D ;# tfr     ccrw, x
        .byte   0xB7, 0x0E ;# tfr     a, yh
        .byte   0xB7, 0x1E ;# tfr     b, yl
        .byte   0xB7, 0x2E ;# tfr     ccrw, y
        .byte   0xB7, 0x0F ;# tfr     a, sph
        .byte   0xB7, 0x1F ;# tfr     b, spl
        .byte   0xB7, 0x2F ;# tfr     ccrw, sp
        sex     ccr, d
        sex     ccr, x
