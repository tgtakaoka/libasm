;;; move
        movw    #0x1234, 0x9ABC
        movw    #0x1234, 7,y
        movw    #0x1234, 0xC8,x
        movw    #0x1234, 0x4321,sp
        movw    #0x1234, [d,y]
        movw    #0x1234, [0x4321,x]
        movw    #0x1234, d,y
        movw    #0x1234, 4,sp-
        movw    0x5678, 0x9ABC
        movw    0x5678, 7,y
        movw    0x5678, 0xC8,x
        movw    0x5678, 0x4321,sp
        movw    0x5678, [d,y]
        movw    0x5678, [0x4321,x]
        movw    0x5678, d,y
        movw    0x5678, 4,sp-
        movw    1,x, 0x9ABC
        movw    1,x, 7,y
        movw    1,x, 0xC8,x
        movw    1,x, 0x4321,sp
        movw    1,x, [d,y]
        movw    1,x, [0x4321,x]
        movw    1,x, d,y
        movw    1,x, 4,sp-
        movw    -0x064,y, 0x9ABC
        movw    -0x064,y, 7,y
        movw    -0x064,y, 0xC8,x
        movw    -0x064,y, 0x4321,sp
        movw    -0x064,y, [d,y]
        movw    -0x064,y, [0x4321,x]
        movw    -0x064,y, d,y
        movw    -0x064,y, 4,sp-
        movw    0x1234,sp, 0x9ABC
        movw    0x1234,sp, 7,y
        movw    0x1234,sp, 0xC8,x
        movw    0x1234,sp, 0x4321,sp
        movw    0x1234,sp, [d,y]
        movw    0x1234,sp, [0x4321,x]
        movw    0x1234,sp, d,y
        movw    0x1234,sp, 4,sp-
        movw    [d,x], 0x9ABC
        movw    [d,x], 7,y
        movw    [d,x], 0xC8,x
        movw    [d,x], 0x4321,sp
        movw    [d,x], [d,y]
        movw    [d,x], [0x4321,x]
        .byte   0x18, 0x02, 0xE7, 0xEE ;# movw    [d,x], d,y
        movw    [d,x], 4,sp-
        movw    [0x1234,y], 0x9ABC
        movw    [0x1234,y], 7,y
        movw    [0x1234,y], 0xC8,x
        movw    [0x1234,y], 0x4321,sp
        movw    [0x1234,y], [d,y]
        movw    [0x1234,y], [0x4321,x]
        .byte   0x18, 0x02, 0xEB, 0x12, 0x34, 0xEE ;# movw    [0x1234,y], d,y
        movw    [0x1234,y], 4,sp-
        movw    a,x, 0x9ABC
        movw    a,x, 7,y
        movw    a,x, 0xC8,x
        movw    a,x, 0x4321,sp
        .byte   0x18, 0x02, 0xE4, 0xEF ;# movw    a,x, [d,y]
        .byte   0x18, 0x02, 0xE4, 0xE3, 0x43, 0x21 ;# movw    a,x, [0x4321,x]
        movw    a,x, d,y
        movw    a,x, 4,sp-
        movw    2,x+, 0x9ABC
        movw    2,x+, 7,y
        movw    2,x+, 0xC8,x
        movw    2,x+, 0x4321,sp
        .byte   0x18, 0x02, 0x31, 0xEF ;# movw    2,x+, [d,y]
        .byte   0x18, 0x02, 0x31, 0xE3, 0x43, 0x21 ;# movw    2,x+, [0x4321,x]
        movw    2,x+, d,y
        movw    2,x+, 4,sp-
        movw    3,-y, 0x9ABC
        movw    3,-y, 7,y
        movw    3,-y, 0xC8,x
        movw    3,-y, 0x4321,sp
        movw    3,-y, [d,y]
        movw    3,-y, [0x4321,x]
        movw    3,-y, d,y
        movw    3,-y, 4,sp-
        movb    #18, 0x9ABC
        movb    #18, 7,y
        movb    #18, 0xC8,x
        movb    #18, 0x4321,sp
        movb    #18, [d,y]
        movb    #18, [0x4321,x]
        movb    #18, d,y
        movb    #18, 4,sp-
        movb    0x5678, 0x9ABC
        movb    0x5678, 7,y
        movb    0x5678, 0xC8,x
        movb    0x5678, 0x4321,sp
        movb    0x5678, [d,y]
        movb    0x5678, [0x4321,x]
        movb    0x5678, d,y
        movb    0x5678, 4,sp-
        movb    1,x, 0x9ABC
        movb    1,x, 7,y
        movb    1,x, 0xC8,x
        movb    1,x, 0x4321,sp
        movb    1,x, [d,y]
        movb    1,x, [0x4321,x]
        movb    1,x, d,y
        movb    1,x, 4,sp-
        movb    -0x064,y, 0x9ABC
        movb    -0x064,y, 7,y
        movb    -0x064,y, 0xC8,x
        movb    -0x064,y, 0x4321,sp
        movb    -0x064,y, [d,y]
        movb    -0x064,y, [0x4321,x]
        movb    -0x064,y, d,y
        movb    -0x064,y, 4,sp-
        movb    0x1234,sp, 0x9ABC
        movb    0x1234,sp, 7,y
        movb    0x1234,sp, 0xC8,x
        movb    0x1234,sp, 0x4321,sp
        movb    0x1234,sp, [d,y]
        movb    0x1234,sp, [0x4321,x]
        movb    0x1234,sp, d,y
        movb    0x1234,sp, 4,sp-
        movb    [d,x], 0x9ABC
        movb    [d,x], 7,y
        movb    [d,x], 0xC8,x
        movb    [d,x], 0x4321,sp
        movb    [d,x], [d,y]
        movb    [d,x], [0x4321,x]
        .byte   0x18, 0x0A, 0xE7, 0xEE ;# movb    [d,x], d,y
        movb    [d,x], 4,sp-
        movb    [0x1234,y], 0x9ABC
        movb    [0x1234,y], 7,y
        movb    [0x1234,y], 0xC8,x
        movb    [0x1234,y], 0x4321,sp
        movb    [0x1234,y], [d,y]
        movb    [0x1234,y], [0x4321,x]
        .byte   0x18, 0x0A, 0xEB, 0x12, 0x34, 0xEE ;# movb    [0x1234,y], d,y
        movb    [0x1234,y], 4,sp-
        movb    b,sp, 0x9ABC
        movb    b,sp, 7,y
        movb    b,sp, 0xC8,x
        movb    b,sp, 0x4321,sp
        .byte   0x18, 0x0A, 0xF5, 0xEF ;# movb    b,sp, [d,y]
        .byte   0x18, 0x0A, 0xF5, 0xE3, 0x43, 0x21 ;# movb    b,sp, [0x4321,x]
        movb    b,sp, d,y
        movb    b,sp, 4,sp-
        movb    2,x+, 0x9ABC
        movb    2,x+, 7,y
        movb    2,x+, 0xC8,x
        movb    2,x+, 0x4321,sp
        .byte   0x18, 0x0A, 0x31, 0xEF ;# movb    2,x+, [d,y]
        .byte   0x18, 0x0A, 0x31, 0xE3, 0x43, 0x21 ;# movb    2,x+, [0x4321,x]
        movb    2,x+, d,y
        movb    2,x+, 4,sp-
        movb    3,-y, 0x9ABC
        movb    3,-y, 7,y
        movb    3,-y, 0xC8,x
        movb    3,-y, 0x4321,sp
        movb    3,-y, [d,y]
        movb    3,-y, [0x4321,x]
        movb    3,-y, d,y
        movb    3,-y, 4,sp-
