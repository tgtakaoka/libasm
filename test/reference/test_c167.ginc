;;; Extended instructions
        atomic  #1
        atomic  #4
        exts    r1, #1
        nop
        extp    r2, #2
        nop
        nop
        exts    #18, #3
        nop
        nop
        nop
        extp    #0x3FF, #4
        nop
        nop
        nop
        nop
        jmps    0xFF, 0x2345
;;; reg and bitoff 80H-EFH address the ESFRs in an EXTR sequence
        .byte   0xD1, 0xA0              ; EXTR    #3
        .byte   0xE6, 0x09, 0x34, 0x12  ; MOV     0F012H, #1234H
        .byte   0x3F, 0x81              ; BSET    0F102H.3
        .byte   0x3F, 0x01              ; BSET    0FD02H.3
        .byte   0x3F, 0x81              ; BSET    0FF02H.3
        push    sp
