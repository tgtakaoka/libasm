far0:   bra     far0x
far0x:  lbra    (.+0x3FFE)
        jmp     far0
        jsr     far0x
        call    far1
        call    0x8000,0x31
        ldaa    far0,pc
        ldab    #%page(far1)
        ldx     #%addr(far1)

;;; Local Variables:
;;; mode: asm
;;; End:
;;; vim: set ft=asm:
